# Supabase project for player accounts. Both values are public by design:
# the publishable key only allows what the row level security policies in
# supabase/migrations allow. Never put a secret or service role key here.
# Without these two lines, accounts are hidden and the game works as before.
VITE_SUPABASE_URL=https://hynbvcxulcklilmeqjtj.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_7ch6DpVtU4YQL9dNJO7VCQ_Px9p8IsR

# Sign-in emails: "false" sends only a link. Turn on ("true") after custom SMTP
# is set up and {{ .Token }} is added to the Magic Link and Confirm signup
# templates, so the email carries a code too. See docs/supabase-setup.md.
VITE_SUPABASE_EMAIL_CODE=false
