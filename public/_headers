# Cloudflare static assets: response headers by path.
# The service worker and the HTML must be revalidated on every load, or users
# could be stuck on an old version. Hashed assets never change.
/sw.js
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
